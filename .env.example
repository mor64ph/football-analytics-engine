# Copy to .env and fill in. .env is gitignored and must stay that way -
# DATABRICKS_TOKEN is a live credential.

# ── Required ─────────────────────────────────────────────────────────────────
# Free key from https://www.football-data.org/client/register
# Used for fixtures, live form, and prediction logging.
FOOTBALL_DATA_API_KEY=your_api_key_here

# ── Deployment ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Unset means allow all,
# which is fine locally. Set it to the Vercel URL in production.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Optional: Databricks ─────────────────────────────────────────────────────
# Leave these unset and the API reads the committed Gold CSVs instead, which is
# what a hosted deployment should do. Set them only for the cloud value
# pipeline on a workspace you control.
#
# WAREHOUSE_ID is the last path segment of HTTP_PATH; set it only to override.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your_pat_token_here
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
# DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxx
# DATABRICKS_CATALOG=main
# DATABRICKS_SCHEMA=transfer_market
# DATABRICKS_NOTEBOOK_PATH=/Users/you@example.com/transfer_market_src/05_databricks_inference

# ── Scheduler (local only; CI uses .github/workflows/refresh.yml) ────────────
REFRESH_INTERVAL_HOURS=24
FASTAPI_URL=http://localhost:8000
